{
  "manifest_version": 2,
  "name": "Upload Layout Recorder",
  "version": "1.4",
  "description": "Records which buttons, menus and fields you use on upload pages, and the field names (never the values) the site's pages send. Never records typed text, passwords or sign-in screens. Nothing is sent anywhere; you save a zip yourself.",
  "browser_specific_settings": {
    "gecko": {
      "id": "upload-layout-recorder@audio-sections",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "<all_urls>",
    "tabs",
    "webRequest",
    "webRequestBlocking",
    "downloads"
  ],
  "background": {
    "scripts": [
      "sites.js",
      "zip.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.fansly.com/*",
        "*://*.redgifs.com/*",
        "*://*.pornhub.com/*",
        "*://pornhub.mainhub.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "Upload Layout Recorder",
    "default_popup": "popup.html"
  }
}
