{
  "manifest_version": 2,
  "name": "Post Helper",
  "version": "2.0",
  "description": "Opens your Clip Organizer clips when you upload on Fansly, RedGifs or Pornhub, fills the caption, and logs what you post. You click Post yourself. Nothing leaves your computer.",
  "browser_specific_settings": {
    "gecko": {
      "id": "post-helper@audio-sections",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "clipboardWrite",
    "webRequest",
    "webRequestBlocking",
    "*://*.fansly.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": [
      "sites.js",
      "store.js",
      "background.js",
      "stats-capture.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.fansly.com/*",
        "*://*.redgifs.com/*",
        "*://*.pornhub.com/*"
      ],
      "js": [
        "sites.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "Post Helper"
  },
  "web_accessible_resources": [
    "picker.html"
  ]
}
