{
  "manifest_version": 2,
  "name": "Post Helper",
  "version": "2.4",
  "description": "Opens your Ducky’s Clip Organizer clips when you upload on Fansly, RedGifs or Pornhub, fills the caption, and keeps track of how your Fansly posts do. You click Post yourself. Nothing leaves your computer.",
  "browser_specific_settings": {
    "gecko": {
      "id": "post-helper@audio-sections",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "webRequest",
    "webRequestBlocking",
    "*://*.fansly.com/*",
    "http://127.0.0.1/*",
    "*://*.redgifs.com/*",
    "*://pornhub.mainhub.com/*"
  ],
  "background": {
    "scripts": [
      "sites.js",
      "store.js",
      "background.js",
      "watcher.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.fansly.com/*",
        "*://*.redgifs.com/*",
        "*://*.pornhub.com/*",
        "*://pornhub.mainhub.com/*"
      ],
      "js": [
        "sites.js",
        "store.js",
        "fill.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "Post Helper"
  },
  "web_accessible_resources": [
    "picker.html"
  ]
}
